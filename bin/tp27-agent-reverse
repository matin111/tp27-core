#!/usr/bin/env bash
set -Eeuo pipefail

ID="${1:?reverse-agent id required}"
CFG="/etc/tp27/reverse-agents/${ID}.json"
[[ -f "$CFG" ]] || { echo "missing $CFG" >&2; exit 2; }

HOST="$(jq -r '.host' "$CFG")"
PORT="$(jq -r '.port // 22' "$CFG")"
USER="$(jq -r '.user // "root"' "$CFG")"
REMOTE_PORT="$(jq -r '.remote_port // 18787' "$CFG")"
KEY="$(jq -r '.key' "$CFG")"
KNOWN_HOSTS="$(jq -r '.known_hosts // "/etc/tp27/known_hosts"' "$CFG")"

python3 - "$HOST" "$PORT" "$REMOTE_PORT" <<'PY'
import ipaddress, sys
ipaddress.ip_address(sys.argv[1])
for value in sys.argv[2:]:
    p=int(value)
    if not 1 <= p <= 65535:
        raise SystemExit('invalid port')
PY

[[ -r "$KEY" ]] || { echo "SSH key is not readable: $KEY" >&2; exit 3; }
install -d -m 700 /etc/tp27
install -m 600 /dev/null "$KNOWN_HOSTS" 2>/dev/null || true

exec /usr/bin/ssh -NT \
  -i "$KEY" \
  -p "$PORT" \
  -o BatchMode=yes \
  -o IdentitiesOnly=yes \
  -o StrictHostKeyChecking=accept-new \
  -o UserKnownHostsFile="$KNOWN_HOSTS" \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=10 \
  -o ServerAliveCountMax=3 \
  -o TCPKeepAlive=yes \
  -R "127.0.0.1:${REMOTE_PORT}:127.0.0.1:8787" \
  "${USER}@${HOST}"
