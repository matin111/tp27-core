#!/usr/bin/env bash
set -Eeuo pipefail

STATE_DIR=/var/lib/tp27-panel-updater
STATE_FILE="$STATE_DIR/state.json"
BACKUP_ROOT=/var/backups/tp27-panel
VERSION_FILE=/etc/tp27/panel-version
LOCK_FILE=/run/tp27-panel-update.lock
REPO_RAW=https://raw.githubusercontent.com/matin111/tp27-core
PANEL=/opt/tp27-panel
STATIC="$PANEL/static"

mkdir -p "$STATE_DIR" "$BACKUP_ROOT"
chmod 700 "$STATE_DIR" "$BACKUP_ROOT"

write_state() {
  local state="$1" message="$2" job_id="$3" target="${4:-}" backup="${5:-}" rollback="${6:-false}"
  python3 - "$STATE_FILE" "$state" "$message" "$job_id" "$target" "$backup" "$rollback" <<'PY'
import json, os, sys, time
from pathlib import Path
p=Path(sys.argv[1])
obj={
    'state':sys.argv[2],
    'message':sys.argv[3],
    'job_id':sys.argv[4],
    'target':sys.argv[5] or None,
    'backup':sys.argv[6] or None,
    'rollback':sys.argv[7].lower()=='true',
    'updated_at':int(time.time()),
}
try:
    old=json.loads(p.read_text())
except Exception:
    old={}
for k in ('current','started_at','unit','channel'):
    if k in old:
        obj[k]=old[k]
if obj['state'] in {'done','failed','rolled_back'}:
    obj['finished_at']=int(time.time())
else:
    obj['finished_at']=old.get('finished_at')
tmp=p.with_suffix('.tmp')
tmp.write_text(json.dumps(obj,ensure_ascii=False,indent=2)+'\n')
os.chmod(tmp,0o600)
os.replace(tmp,p)
PY
}

current_version() {
  local v=""
  [[ -f "$VERSION_FILE" ]] && v="$(tr -d '[:space:]' < "$VERSION_FILE" | tr '[:upper:]' '[:lower:]')"
  if [[ "$v" =~ ^[0-9a-f]{40}$ ]]; then printf '%s\n' "$v"; else printf 'unknown\n'; fi
}

capture_data_planes() {
  systemctl list-units 'tp27-link@*.service' 'tp27-framed@*.service' \
    --type=service --state=running --no-legend --no-pager 2>/dev/null \
    | awk '{print $1}' | sort -u
}

verify_data_planes() {
  local unit
  while IFS= read -r unit; do
    [[ -z "$unit" ]] && continue
    systemctl is-active --quiet "$unit" || {
      echo "DATA_PLANE_NOT_ACTIVE=$unit" >&2
      return 1
    }
  done <<<"${DATA_PLANES_BEFORE:-}"
  return 0
}

verify_panel_basic() {
  systemctl is-active --quiet tp27-panel.service || return 1
  for _ in $(seq 1 20); do
    if curl -kfsS --connect-timeout 2 --max-time 4 https://127.0.0.1:8787/login >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  return 1
}

verify_panel_smoke() {
  verify_panel_basic || return 1

  "$PANEL/venv/bin/python" -m compileall -q "$PANEL" || {
    echo 'SMOKE_FAIL=python-compile' >&2
    return 1
  }

  if command -v node >/dev/null 2>&1; then
    local js
    for js in \
      app.js fast-ui.js agent-manage.js premium-ui.js runtime-refresh-fix.js \
      benchmark-ui.js benchmark-auto.js server-speed-ui.js speed-recovery-fix.js \
      safe-switch-ui.js self-update.js ui-stability.js; do
      node --check "$STATIC/$js" >/dev/null 2>&1 || {
        echo "SMOKE_FAIL=javascript-syntax:$js" >&2
        return 1
      }
    done
  fi

  "$PANEL/venv/bin/python" - <<'PY'
import hashlib
import hmac
import json
import ssl
import time
import urllib.request
from pathlib import Path

BASE='https://127.0.0.1:8787'
ctx=ssl._create_unverified_context()
cfg=json.loads(Path('/etc/tp27/panel.json').read_text(encoding='utf-8'))
exp=str(int(time.time())+300)
sig=hmac.new(bytes.fromhex(cfg['session_secret']),exp.encode(),hashlib.sha256).hexdigest()
cookie=f'tp27_session={exp}.{sig}'


def get(path, auth=False):
    headers={'User-Agent':'TP27-PostUpdate-Smoke/1.0'}
    if auth:
        headers['Cookie']=cookie
    req=urllib.request.Request(BASE+path,headers=headers)
    with urllib.request.urlopen(req,timeout=5,context=ctx) as r:
        body=r.read()
        if r.status != 200:
            raise RuntimeError(f'{path}: HTTP {r.status}')
        return body

login=get('/login')
if b'<html' not in login.lower() and b'<!doctype' not in login.lower():
    raise RuntimeError('/login did not return HTML')

home=get('/',auth=True).decode('utf-8','replace')
required_refs=(
    '/static/style.css',
    '/static/premium.css',
    '/static/app.js',
    '/static/premium-ui.js',
    '/static/runtime-refresh-fix.js',
    '/static/safe-switch-ui.js',
    '/static/ui-stability.js',
)
for ref in required_refs:
    if ref not in home:
        raise RuntimeError(f'index missing {ref}')

for path in required_refs:
    body=get(path)
    if len(body) < 32:
        raise RuntimeError(f'{path}: empty/too small')

status=json.loads(get('/api/status',auth=True).decode('utf-8'))
if not isinstance(status,dict) or not isinstance(status.get('exits'),list):
    raise RuntimeError('/api/status contract failed')
agents=json.loads(get('/api/agents',auth=True).decode('utf-8'))
if not isinstance(agents,dict) or not isinstance(agents.get('agents'),list):
    raise RuntimeError('/api/agents contract failed')
print(f"SMOKE_API=OK EXITS={len(status['exits'])} AGENTS={len(agents['agents'])}")
PY

  verify_data_planes || return 1
  return 0
}

restore_backup() {
  local backup="$1"
  [[ -f "$backup/system.tar.gz" ]] || return 1
  tar -xzf "$backup/system.tar.gz" -C / || return 1
  if [[ -f "$backup/version.before" ]]; then
    cp -a "$backup/version.before" "$VERSION_FILE"
  else
    rm -f "$VERSION_FILE"
  fi
  systemctl daemon-reload
  systemctl restart tp27-panel.service || true
  systemctl restart tp27-ports-reconcile.service 2>/dev/null || true
  systemctl restart tp27-plain-control.service 2>/dev/null || true
  systemctl restart tp27-benchmark.service 2>/dev/null || true
  verify_panel_basic
}

fail_with_rollback() {
  local message="$1" job_id="$2" target="$3" backup_name="$4" backup="$5"
  write_state rolling_back "$message؛ Rollback خودکار شروع شد" "$job_id" "$target" "$backup_name" true
  if restore_backup "$backup"; then
    write_state failed "$message؛ نسخه قبلی با موفقیت بازگردانده شد" "$job_id" "$target" "$backup_name" true
  else
    write_state failed "$message؛ Rollback نیز ناموفق بود و بررسی دستی لازم است" "$job_id" "$target" "$backup_name" true
  fi
  exit 1
}

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  echo "ERROR: another panel update is running" >&2
  exit 75
fi

if [[ "${1:-}" == "--rollback" ]]; then
  BACKUP_NAME="${2:-}"
  JOB_ID="${3:-rollback}"
  [[ "$BACKUP_NAME" =~ ^[A-Za-z0-9._-]+$ ]] || { write_state failed 'نام Backup نامعتبر است' "$JOB_ID" '' "$BACKUP_NAME" true; exit 2; }
  BACKUP="$BACKUP_ROOT/$BACKUP_NAME"
  write_state rolling_back 'در حال بازگردانی نسخه قبلی' "$JOB_ID" '' "$BACKUP_NAME" true
  if restore_backup "$BACKUP"; then
    write_state rolled_back 'Rollback با موفقیت انجام شد' "$JOB_ID" "$(current_version)" "$BACKUP_NAME" true
    exit 0
  fi
  write_state failed 'Rollback ناموفق بود؛ وضعیت سرویس را بررسی کنید' "$JOB_ID" '' "$BACKUP_NAME" true
  exit 1
fi

TARGET="${1:-}"
JOB_ID="${2:-update}"
[[ "$TARGET" =~ ^[0-9a-f]{40}$ ]] || { write_state failed 'SHA هدف نامعتبر است' "$JOB_ID" "$TARGET" '' false; exit 2; }

CURRENT="$(current_version)"
DATA_PLANES_BEFORE="$(capture_data_planes)"
STAMP="$(date -u +%Y%m%d-%H%M%S)"
BACKUP_NAME="${STAMP}-${CURRENT:0:12}"
BACKUP="$BACKUP_ROOT/$BACKUP_NAME"

mkdir -p "$BACKUP"
chmod 700 "$BACKUP"
printf '%s\n' "$CURRENT" > "$BACKUP/version.before"
printf '%s\n' "$DATA_PLANES_BEFORE" > "$BACKUP/data-planes.before"
chmod 600 "$BACKUP/version.before" "$BACKUP/data-planes.before"

write_state backup 'در حال تهیه Backup تراکنشی و Snapshot سرویس‌های Data Plane' "$JOB_ID" "$TARGET" "$BACKUP_NAME" false

# Backup only files the managed installer may replace. Runtime state such as
# config.json, port mappings and Agent secrets is intentionally not restored.
set +e
tar -C / -czf "$BACKUP/system.tar.gz" \
  --exclude='opt/tp27-panel/venv' \
  opt/tp27-panel \
  etc/systemd/system/tp27-panel.service \
  etc/systemd/system/tp27-ports-reconcile.service \
  etc/systemd/system/tp27-plain-control.service \
  etc/systemd/system/tp27-benchmark.service \
  usr/local/lib/tp27
TAR_RC=$?
set -e
if [[ "$TAR_RC" -ne 0 ]]; then
  write_state failed 'ساخت Backup ناموفق بود؛ هیچ تغییری اعمال نشد' "$JOB_ID" "$TARGET" "$BACKUP_NAME" false
  exit 1
fi

ln -sfn "$BACKUP" "$BACKUP_ROOT/latest-successful"

INSTALLER="$(mktemp /tmp/tp27-panel-update.XXXXXX.sh)"
trap 'rm -f "$INSTALLER"' EXIT

write_state downloading 'در حال دریافت نسخه Stable از GitHub با Retry خودکار' "$JOB_ID" "$TARGET" "$BACKUP_NAME" false
set +e
curl -fL \
  --retry 6 \
  --retry-all-errors \
  --retry-delay 2 \
  --connect-timeout 20 \
  --max-time 180 \
  --speed-time 30 \
  --speed-limit 1024 \
  "$REPO_RAW/$TARGET/install-panel-managed.sh" -o "$INSTALLER"
CURL_RC=$?
set -e
if [[ "$CURL_RC" -ne 0 || ! -s "$INSTALLER" ]]; then
  write_state failed 'دریافت نسخه جدید پس از چند تلاش ناموفق بود؛ هیچ فایل فعالی تغییر نکرد' "$JOB_ID" "$TARGET" "$BACKUP_NAME" false
  exit 1
fi
chmod 700 "$INSTALLER"

write_state installing 'در حال نصب نسخه جدید؛ سپس Smoke Test کامل UI/API اجرا می‌شود و Tunnelهای فعال Restart نمی‌شوند' "$JOB_ID" "$TARGET" "$BACKUP_NAME" false
set +e
TP27_REPO_RAW="$REPO_RAW/$TARGET" \
TP27_INSTALL_COMMIT="$TARGET" \
bash "$INSTALLER"
RC=$?
set -e

if [[ "$RC" -eq 0 ]]; then
  write_state verifying 'نصب انجام شد؛ در حال بررسی Python/JS/UI/API و تداوم Data Plane' "$JOB_ID" "$TARGET" "$BACKUP_NAME" false
  if verify_panel_smoke; then
    printf '%s\n' "$TARGET" > "$VERSION_FILE"
    chmod 600 "$VERSION_FILE"
    write_state done 'بروزرسانی Stable و Smoke Test کامل با موفقیت انجام شد' "$JOB_ID" "$TARGET" "$BACKUP_NAME" false
    mapfile -t OLD < <(find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -nr | awk 'NR>5{$1=""; sub(/^ /,""); print}')
    for p in "${OLD[@]:-}"; do [[ -n "$p" ]] && rm -rf -- "$p"; done
    exit 0
  fi
fi

fail_with_rollback 'نصب یا Post-Update Smoke Test نسخه جدید ناموفق بود' "$JOB_ID" "$TARGET" "$BACKUP_NAME" "$BACKUP"
