#!/usr/bin/env bash
set -Eeuo pipefail

ID="${1:?instance id required}"
CFG="/etc/tp27/exits/${ID}.json"
[[ -f "$CFG" ]] || { echo "missing $CFG" >&2; exit 1; }

ROLE="$(jq -r '.role' "$CFG")"
IFACE="$(jq -r '.interface' "$CFG")"
ADDR="$(jq -r '.tunnel_ip' "$CFG")"
MTU="$(jq -r '.mtu // 1400' "$CFG")"
TRANSPORT="$(jq -r '.transport // "gre"' "$CFG")"

[[ -n "$IFACE" && "$IFACE" != "null" ]] || { echo "invalid interface" >&2; exit 2; }
[[ -n "$ADDR" && "$ADDR" != "null" ]] || { echo "invalid tunnel_ip" >&2; exit 2; }

read -r LOCAL_IP PEER_IP PREFIX <<<"$(python3 - "$ADDR" <<'PY'
import ipaddress, sys
iface = ipaddress.ip_interface(sys.argv[1])
hosts = list(iface.network.hosts())
peers = [str(x) for x in hosts if x != iface.ip]
peer = peers[0] if len(peers) == 1 else ''
print(str(iface.ip), peer, iface.network.prefixlen)
PY
)"

IPT="$(command -v iptables || true)"
IP6T="$(command -v ip6tables || true)"
GRE_LOCAL_PUBLIC=""
GRE_REMOTE_PUBLIC=""
GRE_KEY=""
FOU_PORT="0"
V6_LOCAL_PUBLIC=""
V6_REMOTE_PUBLIC=""
WG_LISTEN_PORT="0"
WG_REMOTE_PORT="0"
SIT_IFACE=""
SIT_LOCAL_PUBLIC=""
SIT_REMOTE_PUBLIC=""
SIT_LOCAL_V6=""
SIT_REMOTE_V6=""
SIT_MTU="1480"
SOCAT_PID=""

ensure_chain_hook() {
  local table="$1" parent="$2" chain="$3"
  [[ -n "$IPT" ]] || return 0
  "$IPT" -w 5 -t "$table" -N "$chain" 2>/dev/null || true
  "$IPT" -w 5 -t "$table" -C "$parent" -j "$chain" 2>/dev/null || \
    "$IPT" -w 5 -t "$table" -I "$parent" 1 -j "$chain"
}

ensure_rule() {
  local table="$1" chain="$2"; shift 2
  [[ -n "$IPT" ]] || return 0
  "$IPT" -w 5 -t "$table" -C "$chain" "$@" 2>/dev/null || \
    "$IPT" -w 5 -t "$table" -A "$chain" "$@"
}

remove_rule() {
  local table="$1" chain="$2"; shift 2
  [[ -n "$IPT" ]] || return 0
  while "$IPT" -w 5 -t "$table" -C "$chain" "$@" 2>/dev/null; do
    "$IPT" -w 5 -t "$table" -D "$chain" "$@" 2>/dev/null || break
  done
}

ensure_v6_chain_hook() {
  local table="$1" parent="$2" chain="$3"
  [[ -n "$IP6T" ]] || return 0
  "$IP6T" -w 5 -t "$table" -N "$chain" 2>/dev/null || true
  "$IP6T" -w 5 -t "$table" -C "$parent" -j "$chain" 2>/dev/null || \
    "$IP6T" -w 5 -t "$table" -I "$parent" 1 -j "$chain"
}

ensure_v6_rule() {
  local table="$1" chain="$2"; shift 2
  [[ -n "$IP6T" ]] || return 0
  "$IP6T" -w 5 -t "$table" -C "$chain" "$@" 2>/dev/null || \
    "$IP6T" -w 5 -t "$table" -A "$chain" "$@"
}

remove_v6_rule() {
  local table="$1" chain="$2"; shift 2
  [[ -n "$IP6T" ]] || return 0
  while "$IP6T" -w 5 -t "$table" -C "$chain" "$@" 2>/dev/null; do
    "$IP6T" -w 5 -t "$table" -D "$chain" "$@" 2>/dev/null || break
  done
}

setup_tun_firewall() {
  [[ -n "$IPT" ]] || return 0
  ensure_chain_hook filter INPUT TP27_TUN_IN
  ensure_chain_hook filter OUTPUT TP27_TUN_OUT
  ensure_chain_hook filter FORWARD TP27_TUN_FWD
  ensure_rule filter TP27_TUN_IN -i "$IFACE" -j ACCEPT
  ensure_rule filter TP27_TUN_OUT -o "$IFACE" -j ACCEPT
  ensure_rule filter TP27_TUN_FWD -i "$IFACE" -j ACCEPT
  ensure_rule filter TP27_TUN_FWD -o "$IFACE" -j ACCEPT
}

cleanup_tun_firewall() {
  remove_rule filter TP27_TUN_IN -i "$IFACE" -j ACCEPT
  remove_rule filter TP27_TUN_OUT -o "$IFACE" -j ACCEPT
  remove_rule filter TP27_TUN_FWD -i "$IFACE" -j ACCEPT
  remove_rule filter TP27_TUN_FWD -o "$IFACE" -j ACCEPT
}

setup_gre_underlay_firewall() {
  [[ -n "$IPT" && -n "$GRE_LOCAL_PUBLIC" && -n "$GRE_REMOTE_PUBLIC" ]] || return 0
  ensure_chain_hook filter INPUT TP27_GRE_IN
  ensure_chain_hook filter OUTPUT TP27_GRE_OUT
  if [[ "$TRANSPORT" == "gre-fou" ]]; then
    ensure_rule filter TP27_GRE_IN -p udp -s "$GRE_REMOTE_PUBLIC/32" -d "$GRE_LOCAL_PUBLIC/32" --dport "$FOU_PORT" -j ACCEPT
    ensure_rule filter TP27_GRE_OUT -p udp -s "$GRE_LOCAL_PUBLIC/32" -d "$GRE_REMOTE_PUBLIC/32" --sport "$FOU_PORT" --dport "$FOU_PORT" -j ACCEPT
  else
    ensure_rule filter TP27_GRE_IN -p 47 -s "$GRE_REMOTE_PUBLIC/32" -d "$GRE_LOCAL_PUBLIC/32" -j ACCEPT
    ensure_rule filter TP27_GRE_OUT -p 47 -s "$GRE_LOCAL_PUBLIC/32" -d "$GRE_REMOTE_PUBLIC/32" -j ACCEPT
  fi
}

setup_sit_underlay_firewall() {
  [[ -n "$IPT" && -n "$SIT_LOCAL_PUBLIC" && -n "$SIT_REMOTE_PUBLIC" ]] || return 0
  ensure_chain_hook filter INPUT TP27_SIT_IN
  ensure_chain_hook filter OUTPUT TP27_SIT_OUT
  ensure_rule filter TP27_SIT_IN -p 41 -s "$SIT_REMOTE_PUBLIC/32" -d "$SIT_LOCAL_PUBLIC/32" -j ACCEPT
  ensure_rule filter TP27_SIT_OUT -p 41 -s "$SIT_LOCAL_PUBLIC/32" -d "$SIT_REMOTE_PUBLIC/32" -j ACCEPT
}

cleanup_sit_underlay_firewall() {
  [[ -n "$IPT" && -n "$SIT_LOCAL_PUBLIC" && -n "$SIT_REMOTE_PUBLIC" ]] || return 0
  remove_rule filter TP27_SIT_IN -p 41 -s "$SIT_REMOTE_PUBLIC/32" -d "$SIT_LOCAL_PUBLIC/32" -j ACCEPT
  remove_rule filter TP27_SIT_OUT -p 41 -s "$SIT_LOCAL_PUBLIC/32" -d "$SIT_REMOTE_PUBLIC/32" -j ACCEPT
}

cleanup_gre_underlay_firewall() {
  [[ -n "$IPT" && -n "$GRE_LOCAL_PUBLIC" && -n "$GRE_REMOTE_PUBLIC" ]] || return 0
  if [[ "$TRANSPORT" == "gre-fou" ]]; then
    remove_rule filter TP27_GRE_IN -p udp -s "$GRE_REMOTE_PUBLIC/32" -d "$GRE_LOCAL_PUBLIC/32" --dport "$FOU_PORT" -j ACCEPT
    remove_rule filter TP27_GRE_OUT -p udp -s "$GRE_LOCAL_PUBLIC/32" -d "$GRE_REMOTE_PUBLIC/32" --sport "$FOU_PORT" --dport "$FOU_PORT" -j ACCEPT
  else
    remove_rule filter TP27_GRE_IN -p 47 -s "$GRE_REMOTE_PUBLIC/32" -d "$GRE_LOCAL_PUBLIC/32" -j ACCEPT
    remove_rule filter TP27_GRE_OUT -p 47 -s "$GRE_LOCAL_PUBLIC/32" -d "$GRE_REMOTE_PUBLIC/32" -j ACCEPT
  fi
}

setup_ipv6_underlay_firewall() {
  [[ -n "$IP6T" && -n "$V6_LOCAL_PUBLIC" && -n "$V6_REMOTE_PUBLIC" ]] || return 0
  ensure_v6_chain_hook filter INPUT TP27_V6_IN
  ensure_v6_chain_hook filter OUTPUT TP27_V6_OUT
  if [[ "$TRANSPORT" == "wireguard-v6" ]]; then
    if [[ "$WG_LISTEN_PORT" -gt 0 ]]; then
      ensure_v6_rule filter TP27_V6_IN -p udp -s "$V6_REMOTE_PUBLIC/128" -d "$V6_LOCAL_PUBLIC/128" --dport "$WG_LISTEN_PORT" -j ACCEPT
    fi
    if [[ "$WG_REMOTE_PORT" -gt 0 ]]; then
      ensure_v6_rule filter TP27_V6_OUT -p udp -s "$V6_LOCAL_PUBLIC/128" -d "$V6_REMOTE_PUBLIC/128" --dport "$WG_REMOTE_PORT" -j ACCEPT
      ensure_v6_rule filter TP27_V6_IN -p udp -s "$V6_REMOTE_PUBLIC/128" -d "$V6_LOCAL_PUBLIC/128" --sport "$WG_REMOTE_PORT" -j ACCEPT
    fi
  else
    ensure_v6_rule filter TP27_V6_IN -p 47 -s "$V6_REMOTE_PUBLIC/128" -d "$V6_LOCAL_PUBLIC/128" -j ACCEPT
    ensure_v6_rule filter TP27_V6_OUT -p 47 -s "$V6_LOCAL_PUBLIC/128" -d "$V6_REMOTE_PUBLIC/128" -j ACCEPT
  fi
}

cleanup_ipv6_underlay_firewall() {
  [[ -n "$IP6T" && -n "$V6_LOCAL_PUBLIC" && -n "$V6_REMOTE_PUBLIC" ]] || return 0
  if [[ "$TRANSPORT" == "wireguard-v6" ]]; then
    if [[ "$WG_LISTEN_PORT" -gt 0 ]]; then
      remove_v6_rule filter TP27_V6_IN -p udp -s "$V6_REMOTE_PUBLIC/128" -d "$V6_LOCAL_PUBLIC/128" --dport "$WG_LISTEN_PORT" -j ACCEPT
    fi
    if [[ "$WG_REMOTE_PORT" -gt 0 ]]; then
      remove_v6_rule filter TP27_V6_OUT -p udp -s "$V6_LOCAL_PUBLIC/128" -d "$V6_REMOTE_PUBLIC/128" --dport "$WG_REMOTE_PORT" -j ACCEPT
      remove_v6_rule filter TP27_V6_IN -p udp -s "$V6_REMOTE_PUBLIC/128" -d "$V6_LOCAL_PUBLIC/128" --sport "$WG_REMOTE_PORT" -j ACCEPT
    fi
  else
    remove_v6_rule filter TP27_V6_IN -p 47 -s "$V6_REMOTE_PUBLIC/128" -d "$V6_LOCAL_PUBLIC/128" -j ACCEPT
    remove_v6_rule filter TP27_V6_OUT -p 47 -s "$V6_LOCAL_PUBLIC/128" -d "$V6_REMOTE_PUBLIC/128" -j ACCEPT
  fi
}

cleanup_fou() {
  return 0
}

ip link del "$IFACE" 2>/dev/null || true

cleanup(){
  local rc=$?
  [[ -n "${SOCAT_PID:-}" ]] && kill "$SOCAT_PID" 2>/dev/null || true
  cleanup_ipv6_underlay_firewall || true
  cleanup_sit_underlay_firewall || true
  cleanup_gre_underlay_firewall || true
  cleanup_tun_firewall || true
  ip link del "$IFACE" 2>/dev/null || true
  [[ -n "${SIT_IFACE:-}" ]] && ip link del "$SIT_IFACE" 2>/dev/null || true
  cleanup_fou || true
  exit "$rc"
}
trap cleanup EXIT INT TERM

setup_common_interface() {
  sysctl -q -w "net.ipv4.conf.${IFACE}.rp_filter=0" 2>/dev/null || true
  setup_tun_firewall
}

run_kernel_keepalive() {
  local label="$1" interval="$2" failures="$3"
  local fail_count=0 last_rx rx_now ping_ok
  last_rx="$(cat "/sys/class/net/${IFACE}/statistics/rx_bytes" 2>/dev/null || echo 0)"
  while true; do
    sleep "$interval"
    if ! ip link show "$IFACE" >/dev/null 2>&1; then
      echo "TP27_${label}_SELFHEAL iface=$IFACE reason=interface-missing action=restart" >&2
      exit 75
    fi
    rx_now="$(cat "/sys/class/net/${IFACE}/statistics/rx_bytes" 2>/dev/null || echo 0)"
    ping_ok=0
    if [[ -n "${PEER_IP:-}" ]] && ping -I "$IFACE" -c 2 -i 0.2 -W 1 "$PEER_IP" >/dev/null 2>&1; then
      ping_ok=1
    fi
    if [[ "$ping_ok" -eq 1 || "$rx_now" -gt "$last_rx" ]]; then
      fail_count=0
    else
      fail_count=$((fail_count + 1))
      if [[ "$fail_count" -le "$failures" ]]; then
        echo "TP27_${label}_KEEPALIVE_FAIL iface=$IFACE peer=${PEER_IP:-none} failure=$fail_count/$failures rx=$rx_now" >&2
      fi
      [[ "$fail_count" -gt "$failures" ]] && fail_count="$failures"
    fi
    last_rx="$rx_now"
  done
}

if [[ "$ROLE" == "sit-ip6gre-iran" || "$ROLE" == "sit-ip6gre-exit" ]]; then
  SIT_IFACE="$(jq -r '.sit_interface' "$CFG")"
  SIT_LOCAL_PUBLIC="$(jq -r '.local_public' "$CFG")"
  SIT_REMOTE_PUBLIC="$(jq -r '.remote_public' "$CFG")"
  SIT_LOCAL_V6="$(jq -r '.sit_local_v6' "$CFG")"
  SIT_REMOTE_V6="$(jq -r '.sit_remote_v6' "$CFG")"
  SIT_MTU="$(jq -r '.sit_mtu // 1480' "$CFG")"
  GRE_KEY="$(jq -r '.gre_key' "$CFG")"
  TXQLEN="$(jq -r '.txqueuelen // 2000' "$CFG")"
  KEEPALIVE_INTERVAL="$(jq -r '.keepalive_interval // 4' "$CFG")"
  KEEPALIVE_FAILURES="$(jq -r '.keepalive_failures // 4' "$CFG")"
  V6_LOCAL_PUBLIC="$SIT_LOCAL_V6"
  V6_REMOTE_PUBLIC="$SIT_REMOTE_V6"

  python3 - "$SIT_LOCAL_PUBLIC" "$SIT_REMOTE_PUBLIC" "$SIT_LOCAL_V6" "$SIT_REMOTE_V6" "$GRE_KEY" "$SIT_MTU" "$MTU" <<'PY'
import ipaddress, sys
l4=ipaddress.ip_address(sys.argv[1]); r4=ipaddress.ip_address(sys.argv[2])
l6=ipaddress.ip_address(sys.argv[3]); r6=ipaddress.ip_address(sys.argv[4])
if l4.version != 4 or r4.version != 4: raise SystemExit('SIT requires IPv4 endpoints')
ula=ipaddress.ip_network('fd00::/8')
if l6.version != 6 or r6.version != 6 or l6 not in ula or r6 not in ula: raise SystemExit('SIT requires ULA IPv6 endpoints')
if ipaddress.ip_network(str(l6) + '/127', strict=False) != ipaddress.ip_network(str(r6) + '/127', strict=False): raise SystemExit('SIT endpoints must share /127')
key=int(sys.argv[5]); sit_mtu=int(sys.argv[6]); mtu=int(sys.argv[7])
if not 1 <= key <= 4294967295: raise SystemExit('invalid GRE key')
if not 1280 <= sit_mtu <= 1480: raise SystemExit('invalid SIT MTU')
if not 1000 <= mtu <= 1432: raise SystemExit('invalid SIT/IP6GRE MTU')
PY

  command -v modprobe >/dev/null 2>&1 && modprobe sit 2>/dev/null || true
  command -v modprobe >/dev/null 2>&1 && modprobe ip6_gre 2>/dev/null || true
  ip link del "$SIT_IFACE" 2>/dev/null || true
  setup_sit_underlay_firewall
  ip tunnel add "$SIT_IFACE" mode sit local "$SIT_LOCAL_PUBLIC" remote "$SIT_REMOTE_PUBLIC" ttl 64
  ip link set dev "$SIT_IFACE" mtu "$SIT_MTU" txqueuelen "$TXQLEN"
  ip -6 addr add "${SIT_LOCAL_V6}/127" dev "$SIT_IFACE"
  ip link set dev "$SIT_IFACE" up
  ip -6 route replace "${SIT_REMOTE_V6}/128" dev "$SIT_IFACE" src "$SIT_LOCAL_V6"
  setup_ipv6_underlay_firewall
  ip link add "$IFACE" type ip6gre local "$SIT_LOCAL_V6" remote "$SIT_REMOTE_V6" key "$GRE_KEY" hoplimit 64
  ip link set dev "$IFACE" mtu "$MTU" txqueuelen "$TXQLEN"
  ip addr add "$ADDR" dev "$IFACE"
  ip link set dev "$IFACE" up
  setup_common_interface

  echo "TP27_SIT_IP6GRE_READY role=$ROLE iface=$IFACE sit=$SIT_IFACE outer=$SIT_LOCAL_PUBLIC->$SIT_REMOTE_PUBLIC v6=$SIT_LOCAL_V6->$SIT_REMOTE_V6 addr=$ADDR peer=$PEER_IP mtu=$MTU sit_mtu=$SIT_MTU key=$GRE_KEY" >&2
  ip -br -6 addr show dev "$SIT_IFACE" >&2 || true
  ip -6 route show dev "$SIT_IFACE" >&2 || true
  ip -br -4 addr show dev "$IFACE" >&2 || true
  run_kernel_keepalive SITIP6GRE "$KEEPALIVE_INTERVAL" "$KEEPALIVE_FAILURES"
fi

if [[ "$ROLE" == "ip6gre-iran" || "$ROLE" == "ip6gre-exit" ]]; then
  V6_LOCAL_PUBLIC="$(jq -r '.local_public_v6' "$CFG")"
  V6_REMOTE_PUBLIC="$(jq -r '.remote_public_v6' "$CFG")"
  GRE_KEY="$(jq -r '.gre_key' "$CFG")"
  TXQLEN="$(jq -r '.txqueuelen // 2000' "$CFG")"
  KEEPALIVE_INTERVAL="$(jq -r '.keepalive_interval // 4' "$CFG")"
  KEEPALIVE_FAILURES="$(jq -r '.keepalive_failures // 4' "$CFG")"

  python3 - "$V6_LOCAL_PUBLIC" "$V6_REMOTE_PUBLIC" "$GRE_KEY" "$MTU" <<'PY'
import ipaddress, sys
local=ipaddress.ip_address(sys.argv[1]); remote=ipaddress.ip_address(sys.argv[2])
if local.version != 6 or remote.version != 6 or not local.is_global or not remote.is_global:
    raise SystemExit('IP6GRE requires global IPv6 endpoints')
key=int(sys.argv[3]); mtu=int(sys.argv[4])
if not 1 <= key <= 4294967295: raise SystemExit('invalid GRE key')
if not 1000 <= mtu <= 1448: raise SystemExit('invalid IP6GRE MTU')
PY

  command -v modprobe >/dev/null 2>&1 && modprobe ip6_gre 2>/dev/null || true
  setup_ipv6_underlay_firewall
  ip link add "$IFACE" type ip6gre \
    local "$V6_LOCAL_PUBLIC" remote "$V6_REMOTE_PUBLIC" \
    key "$GRE_KEY" hoplimit 64
  ip link set dev "$IFACE" mtu "$MTU" txqueuelen "$TXQLEN"
  ip addr add "$ADDR" dev "$IFACE"
  ip link set dev "$IFACE" up
  setup_common_interface

  echo "TP27_IP6GRE_READY role=$ROLE iface=$IFACE underlay=$V6_LOCAL_PUBLIC->$V6_REMOTE_PUBLIC addr=$ADDR peer=$PEER_IP mtu=$MTU key=$GRE_KEY" >&2
  ip -br -4 addr show dev "$IFACE" >&2 || true
  ip -6 tunnel show "$IFACE" >&2 || true
  run_kernel_keepalive IP6GRE "$KEEPALIVE_INTERVAL" "$KEEPALIVE_FAILURES"
fi

if [[ "$ROLE" == "wireguard-v6-iran" || "$ROLE" == "wireguard-v6-exit" ]]; then
  V6_LOCAL_PUBLIC="$(jq -r '.local_public_v6' "$CFG")"
  V6_REMOTE_PUBLIC="$(jq -r '.remote_public_v6' "$CFG")"
  WG_PRIVATE="$(jq -r '.wg_private_key_file' "$CFG")"
  WG_PEER_KEY="$(jq -r '.wg_peer_public_key' "$CFG")"
  WG_LISTEN_PORT="$(jq -r '.listen_port // 0' "$CFG")"
  WG_REMOTE_PORT="$(jq -r '.remote_port // 0' "$CFG")"
  WG_KEEPALIVE="$(jq -r '.persistent_keepalive // 15' "$CFG")"
  TXQLEN="$(jq -r '.txqueuelen // 2000' "$CFG")"

  [[ -s "$WG_PRIVATE" ]] || { echo "WireGuard private key missing" >&2; exit 5; }
  command -v wg >/dev/null 2>&1 || { echo "wg binary missing" >&2; exit 5; }
  command -v modprobe >/dev/null 2>&1 && modprobe wireguard 2>/dev/null || true
  setup_ipv6_underlay_firewall

  ip link add "$IFACE" type wireguard
  if [[ "$WG_LISTEN_PORT" -gt 0 ]]; then
    wg set "$IFACE" private-key "$WG_PRIVATE" listen-port "$WG_LISTEN_PORT"
  else
    wg set "$IFACE" private-key "$WG_PRIVATE"
  fi
  if [[ "$ROLE" == "wireguard-v6-iran" ]]; then
    [[ "$WG_REMOTE_PORT" -gt 0 ]] || { echo "invalid WireGuard remote port" >&2; exit 5; }
    wg set "$IFACE" peer "$WG_PEER_KEY" \
      allowed-ips "${PEER_IP}/32" \
      endpoint "[${V6_REMOTE_PUBLIC}]:${WG_REMOTE_PORT}" \
      persistent-keepalive "$WG_KEEPALIVE"
  else
    wg set "$IFACE" peer "$WG_PEER_KEY" allowed-ips "${PEER_IP}/32"
  fi
  ip link set dev "$IFACE" mtu "$MTU" txqueuelen "$TXQLEN"
  ip addr add "$ADDR" dev "$IFACE"
  ip link set dev "$IFACE" up
  setup_common_interface

  echo "TP27_WGV6_READY role=$ROLE iface=$IFACE underlay=$V6_LOCAL_PUBLIC->$V6_REMOTE_PUBLIC addr=$ADDR peer=$PEER_IP mtu=$MTU listen=$WG_LISTEN_PORT remote_port=$WG_REMOTE_PORT" >&2
  wg show "$IFACE" >&2 || true
  run_kernel_keepalive WGV6 4 5
fi

if [[ "$ROLE" == "gre-iran" || "$ROLE" == "gre-exit" ]]; then
  GRE_LOCAL_PUBLIC="$(jq -r '.local_public' "$CFG")"
  GRE_REMOTE_PUBLIC="$(jq -r '.remote_public' "$CFG")"
  GRE_KEY="$(jq -r '.gre_key' "$CFG")"
  TXQLEN="$(jq -r '.txqueuelen // 1000' "$CFG")"
  KEEPALIVE_INTERVAL="$(jq -r '.keepalive_interval // 5' "$CFG")"
  KEEPALIVE_FAILURES="$(jq -r '.keepalive_failures // 4' "$CFG")"
  FOU_PORT="$(jq -r '.fou_port // 0' "$CFG")"

  python3 - "$GRE_LOCAL_PUBLIC" "$GRE_REMOTE_PUBLIC" "$GRE_KEY" "$KEEPALIVE_INTERVAL" "$KEEPALIVE_FAILURES" "$TRANSPORT" "$FOU_PORT" <<'PY'
import ipaddress, sys
ipaddress.ip_address(sys.argv[1]); ipaddress.ip_address(sys.argv[2])
key=int(sys.argv[3]); interval=int(sys.argv[4]); failures=int(sys.argv[5]); transport=sys.argv[6]; fou_port=int(sys.argv[7])
if key < 1 or key > 4294967295: raise SystemExit('invalid GRE key')
if interval < 2 or interval > 60: raise SystemExit('invalid GRE keepalive interval')
if failures < 3 or failures > 20: raise SystemExit('invalid GRE keepalive failure threshold')
if transport not in {'gre', 'gre-fou'}: raise SystemExit('invalid GRE transport')
if transport == 'gre-fou' and not (fou_port == 443 or 1024 <= fou_port <= 65535): raise SystemExit('invalid FOU port')
PY

  command -v modprobe >/dev/null 2>&1 && modprobe ip_gre 2>/dev/null || true
  if [[ "$TRANSPORT" == "gre-fou" ]]; then
    command -v modprobe >/dev/null 2>&1 && modprobe fou 2>/dev/null || true
    if ! ip fou add port "$FOU_PORT" ipproto 47 2>/dev/null; then
      if ! ip fou show 2>/dev/null | grep -Eq "port[[:space:]]+$FOU_PORT([[:space:]]|$)"; then
        echo "failed to register FOU UDP port $FOU_PORT" >&2
        exit 4
      fi
    fi
  fi

  setup_gre_underlay_firewall
  if [[ "$TRANSPORT" == "gre-fou" ]]; then
    ip link add "$IFACE" type gre \
      local "$GRE_LOCAL_PUBLIC" remote "$GRE_REMOTE_PUBLIC" \
      key "$GRE_KEY" ttl 255 \
      encap fou encap-sport "$FOU_PORT" encap-dport "$FOU_PORT"
  else
    ip tunnel add "$IFACE" mode gre \
      local "$GRE_LOCAL_PUBLIC" remote "$GRE_REMOTE_PUBLIC" \
      ttl 255 key "$GRE_KEY"
  fi

  ip link set dev "$IFACE" mtu "$MTU" txqueuelen "$TXQLEN"
  ip addr flush dev "$IFACE" scope global 2>/dev/null || true
  ip addr add "$ADDR" dev "$IFACE"
  ip link set dev "$IFACE" up
  setup_common_interface

  echo "TP27_GRE_READY role=$ROLE transport=$TRANSPORT iface=$IFACE local_public=$GRE_LOCAL_PUBLIC remote_public=$GRE_REMOTE_PUBLIC addr=$ADDR peer=${PEER_IP:-none} mtu=$MTU key=$GRE_KEY fou_port=$FOU_PORT keepalive=${KEEPALIVE_INTERVAL}s/${KEEPALIVE_FAILURES}" >&2
  ip -br -4 addr show dev "$IFACE" >&2 || true
  ip -4 route show dev "$IFACE" >&2 || true
  ip -s link show dev "$IFACE" >&2 || true
  run_kernel_keepalive GRE "$KEEPALIVE_INTERVAL" "$KEEPALIVE_FAILURES"
fi

TUN_SPEC="TUN,tun-name=${IFACE},tun-type=tun,iff-no-pi"

case "$ROLE" in
  exit)
    PORT="$(jq -r '.listen_port' "$CFG")"
    CERT="$(jq -r '.cert' "$CFG")"
    KEY="$(jq -r '.key' "$CFG")"
    CLIENT_CA="$(jq -r '.client_ca' "$CFG")"
    socat -d -d "$TUN_SPEC" "OPENSSL-LISTEN:${PORT},reuseaddr,keepalive,nodelay,cert=${CERT},key=${KEY},cafile=${CLIENT_CA},verify=1" &
    ;;
  iran)
    ENDPOINT="$(jq -r '.endpoint' "$CFG")"
    PORT="$(jq -r '.listen_port' "$CFG")"
    CAFILE="$(jq -r '.ca_file' "$CFG")"
    CERT="$(jq -r '.cert' "$CFG")"
    KEY="$(jq -r '.key' "$CFG")"
    socat -d -d "$TUN_SPEC" "OPENSSL:${ENDPOINT}:${PORT},keepalive,nodelay,cafile=${CAFILE},cert=${CERT},key=${KEY},verify=1,commonname=${ENDPOINT}" &
    ;;
  iran-listen)
    PORT="$(jq -r '.listen_port' "$CFG")"
    CERT="$(jq -r '.cert' "$CFG")"
    KEY="$(jq -r '.key' "$CFG")"
    CLIENT_CA="$(jq -r '.client_ca' "$CFG")"
    socat -d -d "$TUN_SPEC" "OPENSSL-LISTEN:${PORT},reuseaddr,keepalive,nodelay,cert=${CERT},key=${KEY},cafile=${CLIENT_CA},verify=1" &
    ;;
  exit-connect)
    ENDPOINT="$(jq -r '.endpoint' "$CFG")"
    PORT="$(jq -r '.listen_port' "$CFG")"
    CAFILE="$(jq -r '.ca_file' "$CFG")"
    CERT="$(jq -r '.cert' "$CFG")"
    KEY="$(jq -r '.key' "$CFG")"
    socat -d -d "$TUN_SPEC" "OPENSSL:${ENDPOINT}:${PORT},keepalive,nodelay,cafile=${CAFILE},cert=${CERT},key=${KEY},verify=1,commonname=${ENDPOINT}" &
    ;;
  *)
    echo "invalid role=$ROLE" >&2
    exit 2
    ;;
esac

SOCAT_PID=$!
READY=0
for _ in $(seq 1 80); do
  if ip link show "$IFACE" >/dev/null 2>&1; then
    ip link set dev "$IFACE" mtu "$MTU"
    ip addr flush dev "$IFACE" scope global 2>/dev/null || true
    if [[ "$PREFIX" == "30" && -n "$PEER_IP" ]]; then
      ip addr add "${LOCAL_IP}/32" peer "${PEER_IP}/32" dev "$IFACE"
      ip route replace "${PEER_IP}/32" dev "$IFACE" src "$LOCAL_IP"
    else
      ip addr add "$ADDR" dev "$IFACE"
    fi
    ip link set dev "$IFACE" up
    setup_common_interface
    READY=1
    break
  fi
  if ! kill -0 "$SOCAT_PID" 2>/dev/null; then break; fi
  sleep 0.1
done

if [[ "$READY" -ne 1 ]]; then
  echo "interface $IFACE was not created" >&2
  wait "$SOCAT_PID"
fi

if ! ip -4 addr show dev "$IFACE" | grep -Fq "inet ${LOCAL_IP}"; then
  echo "failed to configure ${ADDR} on ${IFACE}" >&2
  ip -4 addr show dev "$IFACE" >&2 || true
  exit 3
fi

echo "TP27_L3_READY role=$ROLE iface=$IFACE local=$LOCAL_IP peer=${PEER_IP:-none} mtu=$MTU" >&2
ip -br -4 addr show dev "$IFACE" >&2 || true
ip -4 route show dev "$IFACE" >&2 || true
if [[ -n "$IPT" ]]; then
  "$IPT" -w 5 -S TP27_TUN_IN 2>/dev/null | grep -F -- "-i $IFACE" >&2 || true
  "$IPT" -w 5 -S TP27_TUN_OUT 2>/dev/null | grep -F -- "-o $IFACE" >&2 || true
  "$IPT" -w 5 -S TP27_TUN_FWD 2>/dev/null | grep -F -- "$IFACE" >&2 || true
fi

wait "$SOCAT_PID"
