[Unit]
Description=TP27 Controller standard HTTPS passthrough
After=network-online.target tp27-panel.service
Wants=network-online.target
Requires=tp27-panel.service

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP4-LISTEN:443,bind=0.0.0.0,reuseaddr,fork TCP4:127.0.0.1:8787
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
