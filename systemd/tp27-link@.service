[Unit]
Description=TP27 Data Plane (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'if [ -x /usr/local/lib/tp27/tp27-link-preflight ]; then exec /usr/local/lib/tp27/tp27-link-preflight "%i"; fi'
ExecStart=/usr/local/lib/tp27/tp27-link-dispatcher %i
Restart=always
RestartSec=2
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
