[Unit]
Description=TP27 Exit Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/tp27-exit-agent/venv/bin/python /opt/tp27-exit-agent/tp27-exit-agent-plain.py --run
Restart=always
RestartSec=5
User=root
Group=root
# The Agent already runs as root and its managed benchmark bootstrap may invoke
# apt, whose helper intentionally switches to the _apt uid.  Blocking setuid
# here breaks that safe drop and produces seteuid/setresuid EPERM on some VPSes.
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/etc/tp27 /var/log/tp27 /run /dev/net/tun /opt/tp27-exit-agent

[Install]
WantedBy=multi-user.target
