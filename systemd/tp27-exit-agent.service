[Unit]
Description=TP27 Exit Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/tp27-exit-agent/venv/bin/python /opt/tp27-exit-agent/tp27-exit-agent-plain.py --run
Restart=always
RestartSec=5
User=root
Group=root
# The Agent already runs as root and its managed benchmark bootstrap may invoke
# apt, whose helper intentionally switches to the _apt uid. Blocking setuid
# here breaks that safe drop and produces seteuid/setresuid EPERM on some VPSes.
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
# TP27's IPv6/SIT capability probe must inspect the host module tree and the
# managed tunnel runtime may require sit/ip6_gre to be available after upgrade.
# Keeping ProtectKernelModules=true creates a false-negative preflight inside
# the Agent sandbox even when the host kernel supports those modules.
ProtectKernelModules=false
ProtectControlGroups=true
ReadWritePaths=/etc/tp27 /var/log/tp27 /run /dev/net/tun /opt/tp27-exit-agent

[Install]
WantedBy=multi-user.target
