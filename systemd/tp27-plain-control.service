[Unit]
Description=TP27 Signed HTTP Control
After=network-online.target tp27-panel.service
Wants=network-online.target
Requires=tp27-panel.service

[Service]
Type=simple
WorkingDirectory=/opt/tp27-panel
Environment=TP27_PLAIN_PORT=443
EnvironmentFile=-/etc/tp27/plain-control.env
ExecStart=/opt/tp27-panel/venv/bin/python /opt/tp27-panel/plain_control.py --host 0.0.0.0 --port ${TP27_PLAIN_PORT}
Restart=always
RestartSec=3
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/etc/tp27 /var/log/tp27

[Install]
WantedBy=multi-user.target
